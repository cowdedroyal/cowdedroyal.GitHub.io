{"aliases":["PPI","Prediction-Powered Inference","预测驱动推断"],"external_ids":{"arxiv":"2301.09633"},"history":[{"agent":"claude-code","at":"2026-11-09T04:21:49.265997+00:00","fields":["id","how","why","kind","name","slug","what","layer","props","status","name_zh","summary","created_at","importance","tracked_at","expanded_at","merged_into","occurred_at","created_by_run"],"intent":"seed: 实习/竞赛项目整理补技术节点（异常检测、生成式推荐、提示词优化、VLM grounding）","op":"insert","reason":null,"run_id":"r_20261109_t6ghyf"}],"node":{"created_at":"2026-11-09T04:21:49.265997+00:00","created_by_run":"r_20261109_t6ghyf","expanded_at":null,"how":null,"id":"n_01m6z8mz3tng0rtzae","importance":3,"kind":"method","layer":"knowledge","merged_into":null,"name":"Prediction-Powered Inference","name_zh":"预测驱动推断","occurred_at":null,"props":{},"reviewed_at":"2026-11-09T04:21:49.302507+00:00","slug":"prediction-powered-inference","status":"active","summary":"用大量模型预测加少量人工标注，给出统计上有效的置信区间的推断框架。","tracked_at":null,"updated_at":"2026-11-09T04:21:49.265997+00:00","updated_by_run":"r_20261109_t6ghyf","what":"先在小标注集上估计模型预测的偏差（修正项），再与大量无标注样本上的预测结合，对均值、分位数、回归系数等给出可证明有效的置信区间。","why":"人工标注贵，只够几百条；模型预测便宜却有偏，直接当真值会得出错误结论。PPI 用少量真值校正偏差，预测越准区间越窄，而且对模型本身不做任何假设。"},"relations":[],"sources":[{"field":null,"published_at":"2023-01-23","publisher":"arXiv","quote":null,"title":"Prediction-Powered Inference","url":"https://arxiv.org/abs/2301.09633"}],"topics":[{"id":"n_01m5eh84srman69g0f","name":"LLM Evaluation","name_zh":"大模型评测","slug":"llm-evaluation"}],"updates":[]}