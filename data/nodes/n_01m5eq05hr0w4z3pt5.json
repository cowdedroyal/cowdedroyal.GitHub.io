ote":null,"title":"Speculative execution","url":"https://en.wikipedia.org/wiki/Speculative_execution"}],"topics":[{"id":"n_01m5er8p4abp2690d5","name":"Computer Systems","name_zh":"计算机系统","slug":"computer-systems"}],"updates":[]}